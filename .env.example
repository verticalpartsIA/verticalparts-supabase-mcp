MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8022

# Personal Access Token (gerado em https://supabase.com/dashboard/account/tokens)
# Preferir o path (arquivo fora do Git, permissão 600) em produção;
# SUPABASE_ACCESS_TOKEN direto só é aceitável em desenvolvimento local.
SUPABASE_ACCESS_TOKEN_PATH=/opt/verticalparts-supabase-mcp/secrets/supabase-access-token
SUPABASE_ACCESS_TOKEN=
SUPABASE_API_BASE=https://api.supabase.com/v1
SUPABASE_DEFAULT_ORG_ID=cdcqhcogckjfttevtoev

SUPABASE_PROJECTS_FILE=./config/projects.yaml
SUPABASE_POLICIES_FILE=./config/policies.yaml
SUPABASE_AUDIT_LOG=./data/audit.jsonl

SUPABASE_ALLOW_BREAK_GLASS=false
